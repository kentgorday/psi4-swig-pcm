+   !> Publish the apparent surface charges `q` and the symmetrized potential adjoint `qsym`
+   !>
+   !> `qsym` is what the host contracts (`w_phi`); for a non-symmetric response
+   !> matrix (IEF-PCM, SS(V)PE) it is not the apparent charge
+   !>
+   !> @param[in]    self  Layer component
+   !> @param[inout] query Field walker
+   subroutine layer_list_fields(self, query)
+      !> Layer component
+      class(pcm_layer_base), intent(in) :: self
+      !> Field walker
+      type(field_query_type), intent(inout) :: query
+
+      call pcm_component_list_fields(self, query)
+      call query%add_real("qsym", "Symmetrized potential adjoint of the latest solve, w_phi (ngrid)", &
+         & self%qsym)
+
+   end subroutine layer_list_fields
