+/// Contract a host functional's surface adjoints into the nuclear gradient (DROP)
+/// The reverse pass moist's own models run on their components' adjoints: the
+/// level-set field, anchor and switching routes, and the volume origin, for an
+/// energy E_host whose surface adjoints are the w_* (dE_host/d observable).
+/// Every channel is optional (NULL leaves it at zero):
+///   w_xi, w_f, w_k1, w_k2, w_a, w_w [ngrid] - widths, switching factors,
+///                                    curvatures, areas, integration weights
+///   w_xyz, w_n  row-major (ngrid, 3)  - point positions, outward normals
+///   w_c[3]                           - volume origin
+/// gradient    row-major (nsph, 3), overwritten with dE_host/dR.
+/// A density-backed level set has no nuclear partials of its own: its field
+/// route is the host's, from moist_contract_cavity_surface_density
+moist_API_ENTRY void moist_API_CALL
+moist_contract_cavity_surface_gradient(moist_error error,
+                                       moist_cavity cavity,
+                                       const double* w_xi /* [ngrid] or NULL */,
+                                       const double* w_f /* [ngrid] or NULL */,
+                                       const double* w_xyz /* : row-major (ngrid, 3), or NULL */,
+                                       const double* w_n /* : row-major (ngrid, 3), or NULL */,
+                                       const double* w_k1 /* [ngrid] or NULL */,
+                                       const double* w_k2 /* [ngrid] or NULL */,
+                                       const double* w_a /* [ngrid] or NULL */,
+                                       const double* w_w /* [ngrid] or NULL */,
+                                       const double* w_c /* [3] or NULL */,
+                                       double* gradient /* : row-major (nsph, 3) */) moist_API_SUFFIX__V_1_0;
+
+/// Contract a host functional's surface adjoints into density weights (DROP)
+/// The electronic counterpart of moist_contract_cavity_surface_gradient: the
+/// weights of a density item, conjugate to rho, grad rho and its Hessian on
+/// the grid with the level set's dS/drho folded in, as the response phase
+/// hands back for moist's own components. The channels are those of
+/// moist_contract_cavity_surface_gradient, without the volume origin.
+/// A surface that does not follow the density writes zeros and sets
+/// *dependent = 0; otherwise *dependent = 1.
+///   w_rho[ngrid], w_grad_rho row-major (ngrid, 3), w_hess_rho row-major
+///   (ngrid, 3, 3), with w_hess_rho[i][b][a] conjugate to the native (a,b,i)
+moist_API_ENTRY void moist_API_CALL
+moist_contract_cavity_surface_density(moist_error error,
+                                      moist_cavity cavity,
+                                      const double* w_xi /* [ngrid] or NULL */,
+                                      const double* w_f /* [ngrid] or NULL */,
+                                      const double* w_xyz /* : row-major (ngrid, 3), or NULL */,
+                                      const double* w_n /* : row-major (ngrid, 3), or NULL */,
+                                      const double* w_k1 /* [ngrid] or NULL */,
+                                      const double* w_k2 /* [ngrid] or NULL */,
+                                      const double* w_a /* [ngrid] or NULL */,
+                                      const double* w_w /* [ngrid] or NULL */,
+                                      double* w_rho /* [ngrid] */,
+                                      double* w_grad_rho /* : row-major (ngrid, 3) */,
+                                      double* w_hess_rho /* : row-major (ngrid, 3, 3) */,
+                                      int* dependent) moist_API_SUFFIX__V_1_0;
+
 /// Contract direct nuclear and electronic PCM terms
 /// Must call moist_compute_cavity_gradient first
 /// Uses cavity-internal ngrid and nsph for array extents
diff --git a/python/moist/interface.py b/python/moist/interface.py
index 2f87281..5ce128f 100644
--- a/python/moist/interface.py
+++ b/python/moist/interface.py
@@ -1004,6 +1004,35 @@ class _CavityDROPBase(Cavity):
             self._handle, w_xi, w_f, w_xyz, w_normal, w_k1, w_k2
         )
 
+    def contract_surface_gradient(self, **weights) -> np.ndarray:
+        """Nuclear gradient (nsph, 3) of a host functional from its surface adjoints.
+
+        The reverse pass moist runs for its own components: ``weights`` are the
+        derivatives of the functional with respect to the surface observables
+        (``w_xyz``, ``w_n``, ``w_a``, ``w_xi``, ``w_f``, ``w_w``, ``w_k1``,
+        ``w_k2``, ``w_c``; each optional).  On a density-backed cavity the
+        field route is the host's: :meth:`contract_surface_density` gives its
+        weights.
+        """
+        self._require_updated()
+        return library.contract_cavity_surface_gradient(self._handle, **weights)
+
+    def contract_surface_density(self, **weights) -> Optional[DensityResponse]:
+        """Density weights of a host functional from its surface adjoints.
+
+        The density item moist's response phase would hand back for the same
+        surface adjoints (``dS/drho`` folded in), or None on a cavity whose
+        surface does not follow the density.  The channels are those of
+        :meth:`contract_surface_gradient` but ``w_c``: the volume origin has no
+        density route, and passing it raises.
+        """
+        self._require_updated()
+        out = library.contract_cavity_surface_density(self._handle, **weights)
+        if out is None:
+            return None
+        w_rho, w_grad_rho, w_hess_rho = out
+        return DensityResponse(w_rho=w_rho, w_grad_rho=w_grad_rho, w_hess_rho=w_hess_rho)
+
     @property
     def nmax(self) -> int:
         return self.snapshot().nmax
diff --git a/python/moist/library.py b/python/moist/library.py
index c1be191..e20eb28 100644
--- a/python/moist/library.py
+++ b/python/moist/library.py
@@ -1378,6 +1378,80 @@ def contract_surface_lsf_weights(
     return w_lsf0, w_lsf1, w_lsf2
 
 
+_SURFACE_CHANNELS = ("w_xi", "w_f", "w_xyz", "w_n", "w_k1", "w_k2", "w_a", "w_w")
+
+
+def _surface_channels(cavity: CavityHandle, weights: dict) -> list:
+    """The surface adjoint channels in API order, as contiguous arrays or None."""
+    ngrid, _ = get_cavity_sizes(cavity)
+    unknown = set(weights) - set(_SURFACE_CHANNELS) - {"w_c"}
+    if unknown:
+        raise TypeError(f"unknown surface channels: {sorted(unknown)}")
+    out = []
+    for name in _SURFACE_CHANNELS:
+        value = weights.get(name)
+        if value is not None:
+            value = np.ascontiguousarray(value, dtype=np.float64)
+            shape = (ngrid, 3) if name in ("w_xyz", "w_n") else (ngrid,)
+            if value.shape != shape:
+                raise ValueError(f"{name} must have shape {shape}, not {value.shape}")
+        out.append(value)
+    return out
+
+
+def contract_cavity_surface_gradient(cavity: CavityHandle, **weights) -> np.ndarray:
+    """Contract a host functional's surface adjoints into its nuclear gradient (nsph, 3).
+
+    Keyword channels (each optional): ``w_xi``, ``w_f``, ``w_k1``, ``w_k2``,
+    ``w_a``, ``w_w`` (ngrid,); ``w_xyz``, ``w_n`` (ngrid, 3); ``w_c`` (3,).
+    """
+    _, nsph = get_cavity_sizes(cavity)
+    channels = _surface_channels(cavity, weights)
+    w_c = weights.get("w_c")
+    if w_c is not None:
+        w_c = np.ascontiguousarray(w_c, dtype=np.float64)
+        if w_c.shape != (3,):
+            raise ValueError("w_c must have shape (3,)")
+    gradient = np.zeros((nsph, 3), dtype=np.float64)
+    error_check(lib.moist_contract_cavity_surface_gradient)(
+        cavity.handle,
+        *(_cast("double*", c) for c in channels),
+        _cast("double*", w_c),
+        _cast("double*", gradient),
+    )
+    return gradient
+
+
+def contract_cavity_surface_density(cavity: CavityHandle, **weights):
+    """Contract a host functional's surface adjoints into density weights.
+
+    Returns ``(w_rho, w_grad_rho, w_hess_rho)``, shapes (ngrid,), (ngrid, 3),
+    (ngrid, 3, 3), or None for a surface that does not follow the density.
+    """
+    if "w_c" in weights:
+        raise TypeError(
+            "w_c: the volume origin moves with the nuclei only and has no density route; "
+            "pass it to contract_cavity_surface_gradient"
+        )
+    ngrid, _ = get_cavity_sizes(cavity)
+    channels = _surface_channels(cavity, weights)
+    w_rho = np.zeros(ngrid, dtype=np.float64)
+    w_grad_rho = np.zeros((ngrid, 3), dtype=np.float64)
+    w_hess_rho = np.zeros((ngrid, 3, 3), dtype=np.float64)
+    dependent = ffi.new("int *")
+    error_check(lib.moist_contract_cavity_surface_density)(
+        cavity.handle,
+        *(_cast("double*", c) for c in channels),
+        _cast("double*", w_rho),
+        _cast("double*", w_grad_rho),
+        _cast("double*", w_hess_rho),
+        dependent,
+    )
+    if not dependent[0]:
+        return None
+    return w_rho, w_grad_rho, w_hess_rho
+
+
 def _char(value: Optional[str]):
     return ffi.new("char[]", value.encode()) if value is not None else ffi.NULL
 
