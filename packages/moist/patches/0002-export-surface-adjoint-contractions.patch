+   !> Contract a host functional's surface adjoints into the nuclear gradient
+   !>
+   !> - the reverse pass moist's own models run on their components' adjoints
+   !>   (`get_surface_gradient`): the level-set field, anchor and switching
+   !>   routes, and the volume origin
+   !> - every channel is optional; NULL leaves it at zero
+   !> - a density-backed level set has no nuclear partials of its own: the
+   !>   host adds its field route from the density weights of
+   !>   moist_contract_cavity_surface_density against its own d rho/dR
+   subroutine contract_cavity_surface_gradient_api(verror, vcav, c_w_xi, c_w_f, c_w_xyz, &
+         & c_w_n, c_w_k1, c_w_k2, c_w_a, c_w_w, c_w_c, c_gradient) &
+         & bind(C, name=namespace//"contract_cavity_surface_gradient")
+      !> Diagnostic handle
+      type(c_ptr), value :: verror
+      type(vp_error), pointer :: error
+      !> Cavity handle
+      type(c_ptr), value :: vcav
+      type(vp_cavity), pointer :: cav
+      !> Surface adjoint channels, or NULL
+      type(c_ptr), value :: c_w_xi, c_w_f, c_w_xyz, c_w_n, c_w_k1, c_w_k2, c_w_a, c_w_w, c_w_c
+      !> Output nuclear gradient, C shape (nsph,3), overwritten
