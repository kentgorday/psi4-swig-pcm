+      end if
+      if (.not. c_associated(c_gradient)) then
+         call api_error(error%ptr, "contract_cavity_surface_gradient", "Null gradient pointer provided")
+         return
+      end if
+
+      call c_f_pointer(c_gradient, gradient, [3, cav%ptr%nsph])
+      call fill_host_surface_adjoint(acc, cav%ptr%ngrid, c_w_xi, c_w_f, c_w_xyz, c_w_n, &
+         & c_w_k1, c_w_k2, c_w_a, c_w_w, c_w_c)
+      gradient = 0.0_wp
+      call cav%ptr%get_surface_gradient(acc, gradient, cavity_error)
+      if (allocated(cavity_error)) then
+         call api_error(error%ptr, "contract_cavity_surface_gradient", cavity_error%message)
+         return
+      end if
+
+   end subroutine contract_cavity_surface_gradient_api
+
+   !> Contract a host functional's surface adjoints into density weights
+   !>
+   !> - the electronic counterpart of moist_contract_cavity_surface_gradient:
+   !>   the weights a density-backed cavity's response item carries
+   !>   (`get_surface_response`), conjugate to rho, grad rho and its Hessian on
+   !>   the grid, with the level set's dS/drho folded in
+   !> - a cavity whose surface does not follow the density writes zeros and
+   !>   reports dependent = 0
+   subroutine contract_cavity_surface_density_api(verror, vcav, c_w_xi, c_w_f, c_w_xyz, &
+         & c_w_n, c_w_k1, c_w_k2, c_w_a, c_w_w, c_w_rho, c_w_grad_rho, c_w_hess_rho, &
+         & dependent) bind(C, name=namespace//"contract_cavity_surface_density")
+      !> Diagnostic handle
+      type(c_ptr), value :: verror
+      type(vp_error), pointer :: error
+      !> Cavity handle
+      type(c_ptr), value :: vcav
+      type(vp_cavity), pointer :: cav
+      !> Surface adjoint channels, or NULL
+      type(c_ptr), value :: c_w_xi, c_w_f, c_w_xyz, c_w_n, c_w_k1, c_w_k2, c_w_a, c_w_w
+      !> Output density weights, C shapes (ngrid), (ngrid,3), (ngrid,3,3)
+      type(c_ptr), value :: c_w_rho, c_w_grad_rho, c_w_hess_rho
+      !> Whether the surface follows the density (1) or not (0)
+      integer(c_int), intent(out) :: dependent
+      real(c_double), pointer :: w_rho(:), w_grad_rho(:, :), w_hess_rho(:, :, :)
+      type(cavity_surface_adjoint_type) :: acc
+      type(error_type), allocatable :: cavity_error
+      real(wp) :: factor
+      integer :: ngrid
+
+      dependent = 0
+      if (.not. c_associated(verror)) return
+      call c_f_pointer(verror, error)
+      if (allocated(error%ptr)) deallocate (error%ptr)
+      if (.not. c_associated(vcav)) then
+         call api_error(error%ptr, "contract_cavity_surface_density", "Cavity handle is missing")
+         return
+      end if
+      call c_f_pointer(vcav, cav)
+      if (.not. associated(cav%ptr)) then
+         call api_error(error%ptr, "contract_cavity_surface_density", "Cavity is not initialized")
+         return
+      end if
+      if (.not. c_associated(c_w_rho) .or. .not. c_associated(c_w_grad_rho) &
+          .or. .not. c_associated(c_w_hess_rho)) then
+         call api_error(error%ptr, "contract_cavity_surface_density", "Null array pointer provided")
+         return
+      end if
+
+      select type (cavity => cav%ptr)
+      type is (cavity_type_drop)
+         ngrid = cavity%ngrid
+         call c_f_pointer(c_w_rho, w_rho, [ngrid])
+         call c_f_pointer(c_w_grad_rho, w_grad_rho, [3, ngrid])
+         call c_f_pointer(c_w_hess_rho, w_hess_rho, [3, 3, ngrid])
+         w_rho = 0.0_wp
+         w_grad_rho = 0.0_wp
+         w_hess_rho = 0.0_wp
+         call cavity%require_built(cavity_error)
+         if (allocated(cavity_error)) then
+            call api_error(error%ptr, "contract_cavity_surface_density", cavity_error%message)
+            return
+         end if
+         if (.not. allocated(cavity%lsf_model)) then
+            call api_error(error%ptr, "contract_cavity_surface_density", &
+                           "Level-set model is not initialized")
+            return
+         end if
+         if (.not. cavity%lsf_model%density_adjoint_factor(factor)) return
+         call fill_host_surface_adjoint(acc, ngrid, c_w_xi, c_w_f, c_w_xyz, c_w_n, &
+            & c_w_k1, c_w_k2, c_w_a, c_w_w, c_null_ptr)
+         call cavity%contract_surface_lsf_weights(acc, w_rho, w_grad_rho, w_hess_rho, cavity_error)
+         if (allocated(cavity_error)) then
+            call api_error(error%ptr, "contract_cavity_surface_density", cavity_error%message)
+            return
+         end if
+         w_rho = factor*w_rho
+         w_grad_rho = factor*w_grad_rho
+         w_hess_rho = factor*w_hess_rho
+         dependent = 1
+      class default
+         call api_error(error%ptr, "contract_cavity_surface_density", &
+                        "Cavity is not DROP type - contraction API only supports DROP cavities")
+      end select
+
+   end subroutine contract_cavity_surface_density_api
